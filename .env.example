# Copy to .env. All settings use the TA_ prefix.

# Where the SQLite database and the object store live.
TA_DATA_DIR=var
# TA_DATABASE_URL=sqlite:///var/teaching_agent.db
# TA_OBJECT_STORE_DIR=var/objects

# API authentication (docs/security.md). There is no anonymous mode: without one of these the API does not start.
# Production: a trusted auth gateway signs the caller's identity; put the shared secret in your secret store.
# TA_AUTH_MODE=gateway
# TA_AUTH_GATEWAY_SECRET=
# Development: bearer tokens from a local file kept outside the repository.
# TA_AUTH_MODE=static
# TA_AUTH_STATIC_TOKENS_FILE=/path/outside/the/repo/tokens.json

# Model routing (tiers, fallbacks, pricing).
TA_ROUTING_FILE=config/routing.toml
# Retrieval over the local knowledge base, and the corpus the mock providers read.
TA_RETRIEVAL_PROVIDER=local
TA_CORPUS_DIR=fixtures/demo

# Review loop and diagnostic policy.
TA_MAX_REVISIONS=2
TA_REVISION_EXHAUSTED_POLICY=fail
TA_DIAGNOSTIC_MAX_ROUNDS=2
TA_DIAGNOSTIC_MEMORY_CONFIDENCE=0.6
TA_DIAGNOSTIC_MAX_QUESTIONS=12
TA_DIAGNOSTIC_MAX_FOLLOW_UPS=1

# Adaptive pedagogy: difficulty bands, mastery target and lesson time (unset: the learner's session length).
TA_PEDAGOGY_BAND_GUIDED=0.3
TA_PEDAGOGY_BAND_INDEPENDENT=0.6
TA_PEDAGOGY_BAND_CONSOLIDATION=0.8
TA_PEDAGOGY_MASTERY_TARGET=0.8
TA_PEDAGOGY_MAX_TARGET_CONCEPTS=2
# TA_PEDAGOGY_LESSON_MINUTES=30

# Research policy.
TA_RESEARCH_REQUIREMENT=mandatory
TA_RESEARCH_MAX_RESULTS=5
TA_RESEARCH_MAX_SOURCES=6
TA_RESEARCH_MIN_RELIABILITY=0.5
TA_RESEARCH_CACHE=true

# Visual policy.
TA_VISUAL_FAILURE_POLICY=fail
TA_VISUAL_MAX_PER_LESSON=6
TA_VISUAL_MAX_CANDIDATES=3

# Presentation: renderer (pptx = local python-pptx, mock = JSON for tests), slide size and deck length.
TA_PRESENTATION_RENDERER=pptx
TA_PRESENTATION_ASPECT_RATIO=16:9
TA_PRESENTATION_MAX_SLIDES=20

# Audio narration (TTS_PROVIDER below picks the speech provider).
TA_AUDIO_FAILURE_POLICY=fail
# TA_AUDIO_LANGUAGE=es-ES
# TA_AUDIO_VOICE=mock-es-ES-1
TA_AUDIO_SPEAKING_RATE=1.0
TA_AUDIO_FORMAT=wav
TA_AUDIO_MAX_WORDS_PER_SEGMENT=80
TA_AUDIO_SILENT_SLIDE_SECONDS=3.0

# Video (needs ffmpeg and ffprobe on PATH for the ffmpeg composer). Unset values keep the VideoConfig defaults:
# 1920x1080, 30 fps, H.264 + AAC in MP4, cut transitions, subtitles burned in, ±0.1 s duration tolerance.
TA_VIDEO_COMPOSER=ffmpeg
TA_VIDEO_FAILURE_POLICY=fail
# TA_VIDEO_WIDTH=1280
# TA_VIDEO_HEIGHT=720
# TA_VIDEO_FPS=30
# TA_VIDEO_TRANSITION=fade
# TA_VIDEO_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf

# Generated video segments: only for lessons that ask for the video.generated_segments capability.
# TA_GENERATED_VIDEO_ENABLED=true
# TA_GENERATED_VIDEO_MIN_SECONDS=3
# TA_GENERATED_VIDEO_MAX_SECONDS=10
# TA_GENERATED_VIDEO_STRATEGY=full_frame_replace   # full_frame_replace | inset
# TA_GENERATED_VIDEO_REQUIRED=false                # optional clips fall back to the slide's image or the slide
# TA_GENERATED_VIDEO_FAILURE_POLICY=fail           # for required clips: fail | continue
# TA_GENERATED_VIDEO_POLL_INTERVAL_SECONDS=5
# TA_GENERATED_VIDEO_POLL_TIMEOUT_SECONDS=600      # then the task WAITs; resuming polls the same jobs
# TA_GENERATED_VIDEO_POLL_MAX_ATTEMPTS=120

TA_LOG_LEVEL=INFO
TA_LOG_JSON=true

# --- Providers (no TA_ prefix). Everything defaults to the offline mock providers. ---------------------------
# Real providers need explicit configuration and their key; keys are never logged, stored or put in artifacts.
# TEACHING_AGENT_MODE=production   # offline (default: mocks only) | production (the providers configured below)
# TEACHING_AGENT_OFFLINE=true      # refuse every network provider (the test suite sets this)
# LLM_PROVIDER=anthropic           # mock | openai | anthropic
# LLM_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# LLM_FALLBACK_PROVIDER=openai     # explicit fallback; nothing falls back silently
# LLM_FALLBACK_MODEL=gpt-5
# LLM_REVIEWER_PROVIDER=openai     # per-role routes: LLM_<ROLE>_PROVIDER / LLM_<ROLE>_MODEL
# LLM_REVIEWER_MODEL=gpt-5
# LLM_INPUT_PRICE_PER_MTOK=5       # optional; without a price the cost is reported as unknown
# LLM_OUTPUT_PRICE_PER_MTOK=25
# TTS_PROVIDER=openai              # mock | openai
# TTS_API_KEY=                     # or OPENAI_API_KEY
# IMAGE_PROVIDER=openai            # mock | openai (generated images only; photos and maps are always searched)
# IMAGE_API_KEY=                   # or OPENAI_API_KEY
# SEARCH_PROVIDER=tavily           # mock | tavily
# SEARCH_API_KEY=                  # or TAVILY_API_KEY
# SEARCH_INCLUDE_DOMAINS=wikipedia.org,britannica.com
# VIDEO_GENERATION_PROVIDER=minimax  # mock | minimax; a key alone never selects MiniMax
# VIDEO_GENERATION_API_KEY=          # or MINIMAX_API_KEY
# VIDEO_GENERATION_MODEL=MiniMax-Hailuo-02
# VIDEO_GENERATION_PRICE_PER_SECOND= # USD; unset: the cost is unknown and the count/seconds limits apply
# LLM_TIMEOUT_SECONDS=120          # per capability: *_TIMEOUT_SECONDS, *_MAX_ATTEMPTS,
# LLM_REQUESTS_PER_MINUTE=50       #   *_REQUESTS_PER_MINUTE, *_MAX_CONCURRENCY

# --- Production runs (scripts/run_production_demo.py; see docs/production.md). Per-task budget, no TA_ prefix. ---
# MAX_LLM_REQUESTS=80
# MAX_LLM_TOKENS=600000
# MAX_SEARCH_REQUESTS=20
# MAX_GENERATED_IMAGES=4
# MAX_SEARCHED_IMAGES=0            # no real image search adapter yet: generated visuals only
# MAX_TTS_CHARACTERS=30000
# MAX_TTS_SECONDS=1800
# MAX_COST_USD=                    # counts known costs only (configure LLM pricing for it to cover the LLM)
# MAX_GENERATED_VIDEO_SEGMENTS=2   # generated video segments per lesson (every lesson that asks for them)
# MAX_GENERATED_VIDEO_SECONDS=20
# MAX_VIDEO_GENERATION_COST_USD=   # needs VIDEO_GENERATION_PRICE_PER_SECOND
# PRODUCTION_HEALTH_TIMEOUT_SECONDS=20
