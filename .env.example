# Copy to .env. All settings use the TA_ prefix.

# Where the SQLite database and the object store live.
TA_DATA_DIR=var
# TA_DATABASE_URL=sqlite:///var/teaching_agent.db
# TA_OBJECT_STORE_DIR=var/objects

# Model routing (tiers, fallbacks, pricing).
TA_ROUTING_FILE=config/routing.toml
# Enabled LLM providers, as a JSON list. Only "mock" has an adapter in this release.
TA_LLM_PROVIDERS=["mock"]

# Search / retrieval / media providers. Only mock/local implementations exist in this release.
TA_SEARCH_PROVIDER=mock
TA_RETRIEVAL_PROVIDER=local
TA_IMAGE_PROVIDER=mock
TA_IMAGE_SEARCH_PROVIDER=mock
TA_TTS_PROVIDER=mock
TA_VIDEO_PROVIDER=mock
TA_CORPUS_DIR=fixtures/demo

# Review loop and diagnostic policy.
TA_MAX_REVISIONS=2
TA_REVISION_EXHAUSTED_POLICY=fail
TA_DIAGNOSTIC_MAX_ROUNDS=2
TA_DIAGNOSTIC_MEMORY_CONFIDENCE=0.6

# Research policy.
TA_RESEARCH_REQUIREMENT=mandatory
TA_RESEARCH_MAX_RESULTS=5
TA_RESEARCH_MAX_SOURCES=6
TA_RESEARCH_MIN_RELIABILITY=0.5
TA_RESEARCH_CACHE=true

# Visual policy.
TA_VISUAL_FAILURE_POLICY=fail
TA_VISUAL_MAX_PER_LESSON=6
TA_VISUAL_MAX_CANDIDATES=3

# Presentation: renderer (pptx = local python-pptx, mock = JSON for tests), slide size and deck length.
TA_PRESENTATION_RENDERER=pptx
TA_PRESENTATION_ASPECT_RATIO=16:9
TA_PRESENTATION_MAX_SLIDES=20

TA_LOG_LEVEL=INFO
TA_LOG_JSON=true
